<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "AS Roma сайт прогнозистов" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="Прогнозы на матчи AS Roma, результаты и таблица участников.">
    <meta name="application-name" content="AS Roma сайт прогнозистов">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#7a1732">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= "admin-area" if controller_path.start_with?("admin/") %>">
    <a href="#main-content" class="skip-link" data-turbo="false">К содержимому</a>
    <header class="site-header">
      <div class="shell header-inner">
        <%= link_to root_path, class: "brand" do %>
          <%= image_tag "roma-crest.png", alt: "Эмблема AS Roma", width: 42, height: 55, class: "brand-crest" %>
          <span class="brand-name">AS Roma <span>сайт прогнозистов</span></span>
        <% end %>
        <% if authenticated? %>
          <nav class="main-nav" aria-label="Основная навигация">
            <%= link_to "Главная", root_path, aria: { current: controller_path == "home" ? "page" : nil } %>
            <%= link_to "Таблица", standings_path, aria: { current: controller_path == "standings" ? "page" : nil } %>
            <%= link_to "Туры", rounds_path, aria: { current: controller_path == "rounds" ? "page" : nil } %>
            <%= link_to "Профиль", profile_path, aria: { current: controller_path == "profiles" ? "page" : nil } %>
            <%= link_to "Админка", admin_root_path, class: "admin-link", aria: { current: controller_path.start_with?("admin/") ? "page" : nil } if current_user&.admin? %>
          </nav>
        <% end %>
      </div>
    </header>

    <div class="page-scene">
      <div class="club-backdrop" aria-hidden="true">
        <%= image_tag "roma-heritage-2011-12.jpg", alt: "", width: 1600, height: 1065, decoding: "async", class: "club-backdrop-photo" %>
      </div>
      <main id="main-content" class="shell page" tabindex="-1">
        <% if flash[:notice] %><div class="alert alert-success" role="status"><%= flash[:notice] %></div><% end %>
        <% if flash[:alert] %><div class="alert alert-error" role="alert"><%= flash[:alert] %></div><% end %>
        <%= yield %>
      </main>
      <footer class="shell site-footer">
        <p lang="it">Daje Roma</p>
        <a href="https://www.asroma.com/en/news/55859/a-career-in-photos-16-of-the-best-de-rossi-shots" target="_blank" rel="noopener noreferrer">Фото: архив AS Roma<span class="sr-only"> (откроется в новой вкладке)</span></a>
      </footer>
    </div>
  </body>
</html>
