<%= render "admin/nav" %>
<div class="page-heading"><h1>Участники прогнозов</h1></div>
<%= form_with url: admin_users_path, method: :get, class: "search-form" do |f| %>
  <div class="field search-field"><%= label_tag :q, "Поиск по нику или email" %><%= text_field_tag :q, @query %></div>
  <div class="actions">
    <%= f.submit "Найти" %>
    <% if @query.present? %><%= link_to "Сбросить", admin_users_path, class: "button button-secondary" %><% end %>
  </div>
<% end %>
<div class="table-wrap">
  <table>
    <thead><tr><th scope="col">Никнейм</th><th scope="col">Email</th><th scope="col">Роль</th><th scope="col" class="numeric">ЗБ</th><th scope="col"><span class="sr-only">Действие</span></th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr><td><strong><%= user.nickname %></strong></td><td><%= user.email_address || "—" %></td><td><%= user_role_label(user) %></td><td class="numeric"><%= user.gold_points_balance(active_season) %></td><td><%= link_to "Открыть", admin_user_path(user) %></td></tr>
      <% end %>
      <% if @users.empty? %><tr><td colspan="5" class="empty">Участники не найдены.</td></tr><% end %>
    </tbody>
  </table>
</div>
