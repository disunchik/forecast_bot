<%= render "admin/nav" %>
<div class="page-heading">
  <h1><%= @user.nickname %></h1>
  <%= link_to "Редактировать", edit_admin_user_path(@user), class: "button button-secondary" %>
</div>

<div class="metrics-grid">
  <div class="metric"><div class="metric-label">Email</div><strong><%= @user.email_address || "Не задан" %></strong></div>
  <div class="metric"><div class="metric-label">Роль</div><strong><%= user_role_label(@user) %></strong></div>
  <div class="metric"><div class="metric-label">ЗБ</div><div class="stat"><%= @user.gold_points_balance(active_season) %></div></div>
</div>

<h2 class="section-heading">Ручная операция ЗБ</h2>
<div class="card">
  <%= form_with url: admin_user_gold_point_transactions_path(@user) do |f| %>
    <div class="grid-2">
      <div class="field"><%= label_tag :amount, "Сумма (+ или -)" %><%= number_field_tag :amount, nil, required: true %></div>
      <div class="field"><%= label_tag :note, "Причина" %><%= text_field_tag :note, nil, required: true %></div>
    </div>
    <%= f.submit "Добавить операцию" %>
  <% end %>
</div>

<h2 class="section-heading">Выдать ачивку</h2>
<div class="card">
  <% available_achievements = Achievement.active.where.not(id: @user.achievement_ids).order(:name) %>
  <% if available_achievements.any? %>
    <% available_achievements.each do |achievement| %>
      <div class="actions">
        <strong><%= achievement.name %></strong>
        <span class="muted"><%= achievement.secret? ? "секретная" : "обычная" %></span>
        <%= button_to "Выдать", award_admin_achievement_path(achievement), method: :post, params: { user_id: @user.id }, class: "button button-small" %>
      </div>
    <% end %>
  <% else %>
    <p class="muted">Доступных ачивок для выдачи нет.</p>
  <% end %>
</div>

<h2 class="section-heading">История ЗБ</h2>
<div class="table-wrap">
  <table>
    <thead><tr><th scope="col">Дата</th><th scope="col">Сумма</th><th scope="col">Причина</th></tr></thead>
    <tbody>
      <% @transactions.each do |tx| %>
        <tr><td><%= moscow_time(tx.created_at) %></td><td class="numeric"><%= tx.amount %></td><td><%= tx.note %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="section-heading">Прогнозы текущего сезона</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">Матч</th><th scope="col">HT</th><th scope="col">FT</th><th scope="col">Ставка ЗБ</th><th scope="col">Баллы</th></tr></thead><tbody>
<% @forecasts.each do |forecast| %><tr><td>№<%= forecast.match.forecast_number %> · <%= match_title(forecast.match) %></td><td class="numeric"><%= match_score(forecast.match, forecast.halftime_roma, forecast.halftime_opponent) %></td><td class="numeric"><%= match_score(forecast.match, forecast.fulltime_roma, forecast.fulltime_opponent) %></td><td class="numeric"><%= forecast.gold_points_stake %></td><td class="numeric"><%= forecast.forecast_score&.total_points || "—" %></td></tr><% end %>
<% if @forecasts.empty? %><tr><td colspan="5" class="empty">Прогнозов нет.</td></tr><% end %>
</tbody></table></div>
