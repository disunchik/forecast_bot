<%= render "shared/errors", object: player %>
<%= form_with model: [:admin, player] do |form| %>
  <div class="field">
    <%= form.label :name, "Имя игрока" %>
    <%= form.text_field :name, required: true, autofocus: player.new_record? && player.errors.empty?, autocomplete: "off" %>
  </div>
  <div class="player-actions">
    <%= form.submit "Сохранить" %>
    <%= link_to "Назад", admin_players_path, class: "button button-secondary" %>
  </div>
<% end %>
