<%= render "admin/nav" %>
<div class="page-heading">
  <h1>Футболисты Ромы</h1>
  <div class="player-actions">
    <%= link_to "Загрузить состав Ромы", admin_new_player_roster_import_path, class: "button" %>
    <%= link_to "Добавить игрока", new_admin_player_path, class: "button button-secondary" %>
  </div>
</div>
<nav class="admin-nav filters" aria-label="Статус футболистов">
  <%= link_to "Активные (#{@active_count})", admin_players_path(tab: "active"), aria: { current: @tab == "active" ? "page" : nil } %>
  <%= link_to "Неактивные (#{@inactive_count})", admin_players_path(tab: "inactive"), aria: { current: @tab == "inactive" ? "page" : nil } %>
</nav>
<% if @players.any? %>
  <ul class="player-list" role="list" aria-label="Футболисты Ромы">
    <% @players.each do |player| %>
      <li class="player-row" id="<%= dom_id(player) %>">
        <h2><%= player.name %></h2>
        <span class="badge"><%= player.active? ? "Активный" : "Неактивный" %></span>
        <div class="player-actions">
          <%= link_to "Изменить", edit_admin_player_path(player), aria: { label: "Изменить игрока #{player.name}" } %>
          <% if player.active? %>
            <%= button_to "В неактивные", archive_admin_player_path(player), method: :patch, class: "button button-small button-secondary", aria: { label: "Перевести #{player.name} в неактивные" } %>
          <% else %>
            <%= button_to "Вернуть", restore_admin_player_path(player), method: :patch, class: "button button-small button-secondary", aria: { label: "Вернуть #{player.name} в активные" } %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="empty">В этом разделе пока нет футболистов.</p>
<% end %>
