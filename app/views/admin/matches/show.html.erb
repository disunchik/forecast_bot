<%= render "admin/nav" %>
<div class="page-heading"><h1>Матч №<%= @match.forecast_number %></h1><div class="actions"><% unless @match.conditions_locked? %><%= link_to "Редактировать", edit_admin_match_path(@match), class: "button button-secondary" %><% end %><%= link_to "Результат матча", edit_admin_match_result_path(@match), class: "button button-gold" %></div></div>
<div class="card"><h2 class="section-heading"><%= match_title(@match) %></h2><dl class="details-list">
<dt>Сезон</dt><dd><%= @match.season.name %></dd><dt>Турнир</dt><dd><%= @match.competition.name %></dd><dt>Начало</dt><dd><%= moscow_time(@match.kickoff_at) %></dd><dt>Открытие прогнозов</dt><dd><%= moscow_time(@match.forecast_opens_at) %></dd><dt>Закрытие</dt><dd><%= moscow_time(@match.forecast_closes_at) %></dd><dt>Статус</dt><dd><%= match_status_label(@match) %></dd><dt>Прогнозов</dt><dd><%= @match.forecasts.count %></dd><dt>Результат</dt><dd><%= result_state_label(@match.match_result) %></dd>
</dl></div>
<% if @match.temporary_question %><div class="card"><h3>Временный вопрос</h3><p><%= @match.temporary_question.text %> (<%= @match.temporary_question.points %> б.)</p><p class="muted"><%= @match.temporary_question.question_type %></p></div><% end %>
<% if @match.conditions_locked? %><div class="alert">Дедлайн прошёл: условия матча и вопрос заблокированы. Ввод фактического результата и откат доступны отдельно.</div><% end %>
<div class="actions"><%= link_to "Удаление матча: посмотреть последствия", deletion_admin_match_path(@match), class: "button button-danger" %></div>

<h2 class="section-heading">Прогнозы участников</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">Участник</th><th scope="col">HT</th><th scope="col">FT</th><th scope="col">ЗБ</th><th scope="col">Изменён</th></tr></thead><tbody>
<% @match.forecasts.includes(:user).order(updated_at: :asc).each do |forecast| %><tr><td><strong><%= forecast.user.nickname %></strong></td><td class="numeric"><%= match_score(forecast.match, forecast.halftime_roma, forecast.halftime_opponent) %></td><td class="numeric"><%= match_score(forecast.match, forecast.fulltime_roma, forecast.fulltime_opponent) %></td><td class="numeric"><%= forecast.gold_points_stake %></td><td><%= moscow_time(forecast.updated_at) %></td></tr><% end %>
<% if @match.forecasts.empty? %><tr><td colspan="5" class="empty">Прогнозов пока нет.</td></tr><% end %>
</tbody></table></div>
