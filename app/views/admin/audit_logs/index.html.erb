<%= render "admin/nav" %><h1>Audit log</h1><div class="table-wrap"><table><thead><tr><th scope="col">Время</th><th scope="col">Админ</th><th scope="col">Действие</th><th scope="col">Объект</th><th scope="col">Детали</th></tr></thead><tbody><% @logs.each do |log| %><tr><td><%= moscow_time(log.created_at) %></td><td><%= log.admin&.nickname || "system" %></td><td><code><%= log.action %></code></td><td><%= [log.auditable_type, log.auditable_id].compact.join(" #") %></td><td><small><%= log.details.to_json %></small></td></tr><% end %><% if @logs.empty? %><tr><td colspan="5" class="empty">Действий пока нет.</td></tr><% end %></tbody></table></div>
