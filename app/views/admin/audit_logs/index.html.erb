<%= render "admin/nav" %><h1>Audit log</h1><div class="table-wrap"><table><thead><tr><th>Время</th><th>Админ</th><th>Действие</th><th>Объект</th><th>Детали</th></tr></thead><tbody><% @logs.each do |log| %><tr><td><%= moscow_time(log.created_at) %></td><td><%= log.admin&.nickname || "system" %></td><td><code><%= log.action %></code></td><td><%= [log.auditable_type, log.auditable_id].compact.join(" #") %></td><td><small><%= log.details.to_json %></small></td></tr><% end %></tbody></table></div>
