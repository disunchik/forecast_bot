<%= render "admin/nav" %><h1>Предварительный расчёт: <%= match_title(@match) %></h1><div class="alert alert-success">Пока ничего не начислено. Проверьте таблицу и только потом подтвердите результат.</div>
<div class="table-wrap"><table><thead><tr><th scope="col">Место</th><th scope="col">Участник</th><th scope="col">Обычные</th><th scope="col">ЗБ применится</th><th scope="col">Итого</th><th scope="col">FT</th><th scope="col">HT</th><th scope="col">Голы</th><th scope="col">Ассисты</th><th scope="col">Врем.</th></tr></thead><tbody><% @rows.each do |row| %><% v=row[:values] %><tr><td class="numeric"><%= row[:placement] %></td><td><strong><%= row[:forecast].user.nickname %></strong></td><td class="numeric"><%= v[:base_points] %></td><td class="numeric"><%= v[:gold_points_applied] %></td><td class="numeric"><strong><%= v[:total_points] %></strong></td><td class="numeric"><%= v[:fulltime_difference_points]+v[:fulltime_exact_points] %></td><td class="numeric"><%= v[:halftime_difference_points]+v[:halftime_exact_points] %></td><td class="numeric"><%= v[:scorer_points] %></td><td class="numeric"><%= v[:assist_points] %></td><td class="numeric"><%= v[:temporary_question_points] %></td></tr><% end %></tbody></table></div>
<div class="actions"><%= link_to "Назад к результату", edit_admin_match_result_path(@match), class: "button button-secondary" %><%= button_to "Подтвердить результат", confirm_admin_match_result_path(@match), method: :post, params: { state_token: @confirmation_token }, class: "button button-danger", data: { turbo_confirm: "После подтверждения будут списаны ставки ЗБ, начислены места и обновлена таблица. Продолжить?" } %></div>
