<%= render "admin/nav" %>
<div class="page-heading">
  <h1>Турниры</h1>
  <%= link_to "Добавить турнир", new_admin_competition_path, class: "button" %>
</div>
<div class="table-wrap">
  <table>
    <thead><tr><th scope="col">Турнир</th><th scope="col">Статус</th><th scope="col"><span class="sr-only">Действие</span></th></tr></thead>
    <tbody>
      <% @competitions.each do |competition| %>
        <tr><td><strong><%= competition.name %></strong></td><td><span class="badge"><%= competition.active? ? "Активный" : "В архиве" %></span></td><td><%= link_to "Редактировать", edit_admin_competition_path(competition) %></td></tr>
      <% end %>
      <% if @competitions.empty? %><tr><td colspan="3" class="empty">Турниры пока не добавлены.</td></tr><% end %>
    </tbody>
  </table>
</div>
