<%= render "admin/nav" %><h1>Золотые баллы</h1>
<%= render "admin/season_picker", url: admin_gold_point_transactions_path %>
<p>Для ручной корректировки откройте профиль участника.</p>
<div class="table-wrap"><table><thead><tr><th scope="col">Участник</th><th scope="col">Баланс</th><th scope="col">Доступно</th></tr></thead><tbody>
<% @users.each do |user| %><tr><td><%= link_to user.nickname, admin_user_path(user) %></td><td class="numeric"><%= user.gold_points_balance(@season) %></td><td class="numeric"><%= user.available_gold_points(@season) %></td></tr><% end %>
<% if @users.empty? %><tr><td colspan="3" class="empty">Участники пока не добавлены.</td></tr><% end %></tbody></table></div>
<h2 class="section-heading">Журнал сезона</h2>
<div class="table-wrap"><table><thead><tr><th scope="col">Дата</th><th scope="col">Участник</th><th scope="col">Сумма</th><th scope="col">Основание</th></tr></thead><tbody>
<% @transactions.each do |tx| %><tr><td><%= moscow_time(tx.created_at) %></td><td><%= tx.user.nickname %></td><td class="numeric"><%= tx.amount %></td><td><%= tx.note %></td></tr><% end %>
<% if @transactions.empty? %><tr><td colspan="4" class="empty">Операций пока нет.</td></tr><% end %></tbody></table></div>
