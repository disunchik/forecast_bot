<%= render "admin/nav" %><h1>Результаты</h1>
<%= render "admin/season_picker", url: admin_results_path %>
<div class="cards">
  <% @matches.each do |match| %>
    <div class="card"><strong>№<%= match.forecast_number %> · <%= match_title(match) %></strong>
      <p><%= result_state_label(match.match_result) %> · <%= moscow_time(match.kickoff_at) %></p>
      <%= link_to "События и расчёт", edit_admin_match_result_path(match), class: "button" %>
    </div>
  <% end %>
</div>
