<%= render "admin/nav" %><h1>Правила начисления</h1>
<div class="table-wrap"><table><thead><tr><th scope="col">Правило</th><th scope="col">Значение</th><th scope="col"><span class="sr-only">Действие</span></th></tr></thead><tbody><% @rules.each do |rule| %><tr><td><strong><%= rule.label %></strong></td><td><%= form_with model: [:admin, rule], url: admin_scoring_rule_path(rule), method: :patch, class: "inline-fields" do |f| %><%= f.number_field :value, class: "rule-value", aria: { label: rule.label } %><%= f.submit "Сохранить", class: "button button-small" %><% end %></td><td></td></tr><% end %><% if @rules.empty? %><tr><td colspan="3" class="empty">Правила пока не добавлены.</td></tr><% end %></tbody></table></div>
