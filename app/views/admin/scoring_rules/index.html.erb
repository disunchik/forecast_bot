<%= render "admin/nav" %><h1>Правила начисления</h1>
<div class="table-wrap"><table><thead><tr><th>Правило</th><th>Значение</th><th></th></tr></thead><tbody><% @rules.each do |rule| %><tr><td><strong><%= rule.label %></strong></td><td><%= form_with model: [:admin, rule], url: admin_scoring_rule_path(rule), method: :patch, class: "inline-fields" do |f| %><%= f.number_field :value, style: "max-width:120px" %><%= f.submit "Сохранить", class: "button button-small" %><% end %></td><td></td></tr><% end %><% if @rules.empty? %><tr><td colspan="3" class="empty">Правила пока не добавлены.</td></tr><% end %></tbody></table></div>
