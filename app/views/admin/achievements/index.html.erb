<%= render "admin/nav" %><div class="page-heading"><h1>Ачивки</h1><%= link_to "Создать ачивку", new_admin_achievement_path, class: "button" %></div>
<div class="table-wrap"><table><thead><tr><th scope="col">Название</th><th scope="col">Выдача</th><th scope="col">Тип</th><th scope="col">Раскрыта</th><th scope="col">Активна</th><th scope="col">Получили</th><th scope="col"><span class="sr-only">Действие</span></th></tr></thead><tbody><% @achievements.each do |a| %><tr><td><strong><%= a.name %></strong><br><span class="muted"><%= a.description %></span></td><td><%= a.rule_label %></td><td><%= a.secret? ? "Секретная" : "Обычная" %></td><td><%= a.revealed? ? "Да" : "Нет" %></td><td><%= a.active? ? "Да" : "Нет" %></td><td class="numeric"><%= a.user_achievements.count %></td><td><%= link_to "Изменить", edit_admin_achievement_path(a) %></td></tr><% end %><% if @achievements.empty? %><tr><td colspan="7" class="empty">Ачивки пока не добавлены.</td></tr><% end %></tbody></table></div>
