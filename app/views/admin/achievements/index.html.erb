<%= render "admin/nav" %><div class="actions" style="justify-content:space-between"><h1>Ачивки</h1><%= link_to "Создать ачивку", new_admin_achievement_path, class: "button" %></div>
<div class="table-wrap"><table><thead><tr><th>Название</th><th>Тип</th><th>Раскрыта</th><th>Активна</th><th>Получили</th><th></th></tr></thead><tbody><% @achievements.each do |a| %><tr><td><strong><%= a.name %></strong><br><span class="muted"><%= a.description %></span></td><td><%= a.secret? ? "Секретная" : "Обычная" %></td><td><%= a.revealed? ? "Да" : "Нет" %></td><td><%= a.active? ? "Да" : "Нет" %></td><td><%= a.user_achievements.count %></td><td><%= link_to "Изменить", edit_admin_achievement_path(a) %></td></tr><% end %></tbody></table></div>
