<%= render "shared/errors", object: achievement %><%= form_with model: [:admin, achievement] do |form| %><div class="field"><%= form.label :name, "Название" %><%= form.text_field :name, required: true %></div><div class="field"><%= form.label :description, "Описание / условие" %><%= form.text_area :description %></div><div class="check-list"><div class="check-item"><%= form.check_box :secret %><%= form.label :secret, "Секретная" %></div><div class="check-item"><%= form.check_box :active %><%= form.label :active, "Активна" %></div></div><div class="actions"><%= form.submit "Сохранить" %><%= link_to "Назад", admin_achievements_path, class: "button button-secondary" %></div><% end %>
