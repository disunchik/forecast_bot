<%= render "admin/nav" %>
<div class="page-heading"><h1>Админка</h1></div>
<div class="metrics-grid">
  <div class="metric"><div class="metric-label">Активный сезон</div><div class="stat metric-value-text"><%= @season&.name || "—" %></div></div>
  <div class="metric"><div class="metric-label">Пользователей</div><div class="stat"><%= @users_count %></div></div>
  <div class="metric"><div class="metric-label">Активных игроков</div><div class="stat"><%= @players_count %></div></div>
</div>
<h2 class="section-heading">Матчи</h2>
<div class="fixture-list">
  <% if @upcoming_matches.empty? %>
    <div class="empty">Предстоящих матчей пока нет.</div>
  <% end %>
  <% @upcoming_matches.each do |match| %>
    <div class="fixture-row">
      <div class="fixture-number">№<%= match.forecast_number %></div>
      <div class="fixture-main">
        <strong><%= match_title(match) %></strong>
        <div class="fixture-meta"><%= moscow_time(match.kickoff_at) %></div>
      </div>
      <div class="fixture-actions"><%= link_to "Открыть", admin_match_path(match), class: "button button-small button-secondary" %></div>
    </div>
  <% end %>
</div>
