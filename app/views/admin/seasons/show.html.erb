<%= render "admin/nav" %><h1>Сезон <%= @season.name %></h1><p><span class="badge"><%= @season.active? ? "Активный" : "Архив" %></span></p>
<div class="actions"><%= link_to "Таблица сезона", admin_standings_path(season_id: @season.id), class: "button" %><%= link_to "Результаты сезона", admin_results_path(season_id: @season.id), class: "button" %></div>
<h2>Матчи</h2><div class="table-wrap"><table><thead><tr><th>№</th><th>Матч</th><th>Результат</th></tr></thead><tbody><% @matches.each do |match| %><tr><td><%= match.forecast_number %></td><td><%= link_to match_title(match), admin_match_path(match) %></td><td><%= result_state_label(match.match_result) %></td></tr><% end %><% if @matches.empty? %><tr><td colspan="3" class="empty">Матчи сезона пока не добавлены.</td></tr><% end %></tbody></table></div>
<h2>Откат результатов</h2><div class="card"><p class="muted">Оставляет подтверждёнными результаты до указанного номера включительно. Более поздние расчёты и таблицы отменяются, списанные ставки возвращаются в резерв. Уже выданные ЗБ за места остаются участникам; повторный расчёт начислит только недостающую разницу при увеличении награды. Прогнозы и введённые события сохраняются.</p><%= form_with url: rollback_preview_admin_season_path(@season), method: :get do |f| %><div class="field" style="max-width:260px"><label>Оставить результаты до матча №</label><%= number_field_tag :keep_through_number, nil, min: 0, required: true %></div><%= f.submit "Посмотреть последствия отката", class: "button button-danger", data: { turbo_confirm: "Точно откатить более поздние результаты?" } %><% end %></div>

<div class="card"><h2>Откат до первого матча</h2>
<%= button_to "Посмотреть откат всех результатов", rollback_preview_admin_season_path(@season), method: :get, params: { before_first: "1" }, data: { turbo_confirm: "Откатить все результаты, сохранив прогнозы и события?" }, class: "button button-danger" %>
</div>
