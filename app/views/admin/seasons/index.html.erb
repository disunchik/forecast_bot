<%= render "admin/nav" %><div class="page-heading"><h1>Сезоны</h1><%= link_to "Новый сезон", new_admin_season_path, class: "button" %></div><div class="table-wrap"><table><thead><tr><th scope="col">Сезон</th><th scope="col">Статус</th><th scope="col">Матчей</th><th scope="col"><span class="sr-only">Действие</span></th></tr></thead><tbody><% @seasons.each do |season| %><tr><td><strong><%= season.name %></strong></td><td><%= season.active? ? "Активный" : "Архив" %></td><td class="numeric"><%= season.matches.count %></td><td><div class="actions"><%= link_to "Открыть", admin_season_path(season) %><% unless season.active? %><%= button_to "Сделать активным", activate_admin_season_path(season), method: :patch, class: "button button-small" %><% end %></div></td></tr><% end %><% if @seasons.empty? %><tr><td colspan="4" class="empty">Сезоны пока не созданы.</td></tr><% end %></tbody></table></div>
