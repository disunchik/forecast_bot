<%= render "admin/nav" %><div class="actions" style="justify-content:space-between"><h1>Сезоны</h1><%= link_to "Новый сезон", new_admin_season_path, class: "button" %></div><div class="table-wrap"><table><thead><tr><th>Сезон</th><th>Статус</th><th>Матчей</th><th></th></tr></thead><tbody><% @seasons.each do |season| %><tr><td><strong><%= season.name %></strong></td><td><%= season.active? ? "Активный" : "Архив" %></td><td><%= season.matches.count %></td><td><div class="actions"><%= link_to "Открыть", admin_season_path(season) %><% unless season.active? %><%= button_to "Сделать активным", activate_admin_season_path(season), method: :patch, class: "button button-small" %><% end %></div></td></tr><% end %></tbody></table></div>
