<% if object.errors.any? %>
  <div id="<%= dom_id(object, :errors) %>" class="alert alert-error" role="alert" tabindex="-1" autofocus>
    <strong>Проверьте данные:</strong>
    <ul>
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
