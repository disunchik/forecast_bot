<div class="forecast-page"><div class="page-heading"><h1>Прогноз: <%= match_title(@match) %></h1></div>
<div class="forecast-context"><span><%= @match.competition.name %></span><span>Матч №<%= @match.forecast_number %></span><strong>Закрытие (МСК) <%= moscow_time(@match.forecast_closes_at) %></strong></div>
<div><%= render "form", forecast: @forecast, match: @match %></div>

</div>
