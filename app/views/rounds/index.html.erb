<div class="page-heading">
  <h1>Туры текущего сезона</h1>
</div>
<div class="fixture-list">
  <% if @matches.empty? %><div class="card empty">Матчи текущего сезона пока не добавлены.</div><% end %>
  <% @matches.each do |match| %>
    <article class="fixture-row">
      <div class="fixture-number numeric">№<%= match.forecast_number %></div>
      <div class="fixture-main">
        <h2><%= match_title(match) %></h2>
        <div class="fixture-meta">
          <span><%= match.competition.name %></span>
          <span><%= moscow_time(match.kickoff_at) %></span>
          <span class="badge"><%= match_status_label(match) %></span>
        </div>
      </div>
      <div class="fixture-actions">
        <% if match.predictions_visible_to_all? %>
          <%= link_to "Открыть тур", round_path(match), class: "button button-small" %>
        <% else %>
          <span class="muted">Прогнозы пока скрыты</span>
        <% end %>
      </div>
    </article>
  <% end %>
</div>
